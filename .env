# Copia este archivo como .env y ajusta los valores. NUNCA subas .env a GitHub.
# (Si no existe, "npm start" lo crea solo a partir de este archivo.)

# ---------- Servidor (solo local) ----------
PORT=3000
# El servidor escucha solo en esta computadora. Para abrirlo también desde otros dispositivos de tu red: HOST=0.0.0.0
HOST=127.0.0.1
# Opcional: dirección que se usa en los enlaces de los correos. Vacío = la dirección con la que abriste el sitio.
BASE_URL=

# ---------- Base de datos: MySQL 8.0.16 o más reciente (instalado en esta computadora) ----------
# La base se crea sola la primera vez (necesita un usuario con permiso para crear bases, por ejemplo root).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=hehurove1709hh
DB_NAME=dopta

# Revisa con DNS que el dominio del correo pueda recibir correo (MX). 0 = solo formato y errores comunes.
VALIDAR_CORREO_DNS=1

# Correo para recuperar contraseña (opcional). Vacío = el enlace se imprime en la consola donde corre "npm start".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Dopta <no-responder@dopta.mx>

# Respaldos (npm run respaldo, requiere mysqldump)
RESPALDO_DIR=respaldos
RESPALDO_DIAS=30
MYSQLDUMP=mysqldump

# Google (opcional). Vacío = la dirección se escribe a mano (el C.P. y las colonias funcionan sin Google).
# GOOGLE_MAPS_API_KEY: "Places API (New)" y "Geocoding API", restringida a esas APIs. La usa solo el servidor.
GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_EMBED_KEY: "Maps Embed API" (sin costo), restringida por dominio. Muestra el mapa al Administrador.
GOOGLE_MAPS_EMBED_KEY=
